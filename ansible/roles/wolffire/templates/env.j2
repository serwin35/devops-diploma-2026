# Zarządzane przez Ansible. Nie edytować na maszynie - zmiany znikną przy
# następnym uruchomieniu playbooka.
#
# Sekrety pochodzą z group_vars/all/secrets.sops.yml, odszyfrowywanego w locie.
# Ten plik NIE jest w repozytorium i nie przechodzi przez CI.
APP_NAME=WolfFire
APP_ENV={{ wolffire_env }}
APP_KEY={{ wolffire_app_key }}
APP_DEBUG={{ 'true' if wolffire_env == 'local' else 'false' }}
APP_URL=https://dev.{{ public_zone }}
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en

# Logi na stdout kontenera - stamtąd zbiera je Alloy i wysyła do Loki.
# Zapis do pliku oznaczałby logi ginące razem z kontenerem.
LOG_CHANNEL=stderr
LOG_LEVEL={{ 'debug' if wolffire_env == 'local' else 'warning' }}

# Nazwy hostów z sieci Dockera - kontenery znajdują się po nazwie usługi.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE={{ wolffire_db_name }}
DB_USERNAME={{ wolffire_db_user }}
DB_PASSWORD={{ wolffire_db_password }}

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ wolffire_redis_password }}

# Kolejki i cache w Redisie - Horizon przetwarza WSZYSTKIE kolejki.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
# Bez dostępu do systemów zewnętrznych harmonogram integracji tylko zapycha
# kolejki - patrz config/integrations.php w aplikacji.
INTEGRATIONS_SYNC_ENABLED=false
SESSION_DRIVER=redis
SESSION_LIFETIME=120
BROADCAST_CONNECTION=log
HORIZON_PREFIX=wolffire_horizon:

# Wolumen lokalny wystarcza na dev. Na produkcji zastąpi go S3, bo wiele replik
# nie może współdzielić wolumenu przypiętego do jednego węzła.
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="alerty@{{ public_zone }}"
MAIL_FROM_NAME=WolfFire

# Integracje zewnętrzne celowo puste na dev - środowisko deweloperskie nie ma
# prawa dotykać systemów produkcyjnych klienta.
NEXO_DMSERVICE_URL=
NEXO_DMSERVICE_TOKEN=
NEXO_CODETRONIC_URL=
NEXO_CODETRONIC_TOKEN=
